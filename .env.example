# Copy this file to .env and replace each value. Never share or commit .env.
# DEPLOYMENT.md explains where to find each of these.

# The bot's secret token, from the Discord Developer Portal (Bot page).
DISCORD_TOKEN=paste-your-bot-token-here

# The ID of your Discord server.
GUILD_ID=000000000000000000

# The ID of the "Create Your Own VC" voice channel.
HUB_CHANNEL_ID=000000000000000000

# The ID of the category where temporary voice channels are created.
TEMP_VC_CATEGORY_ID=000000000000000000

# The ID of the text channel where people use /topic, such as #find-your-group.
TOPIC_CHANNEL_ID=000000000000000000
